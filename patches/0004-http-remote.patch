+# ---- NanoHTTPD (org.nanohttpd:nanohttpd) ----
+# Note: the artifact id is org.nanohttpd, but the classes ship in the legacy
+# fi.iki.elonen package (verified against nanohttpd-2.3.1.jar).
+# NanoHTTPD loads its MIME type tables from classpath resources
+# (META-INF/nanohttpd/default-mimetypes.properties, mimetypes.properties) and
+# instantiates its TempFileManagerFactory / AsyncRunner / ServerSocketFactory
+# chain reflectively, so R8 cannot see those edges. Keeping the whole library is
+# the cheap, correct remedy (~50 KB of dex).
+-keep class fi.iki.elonen.** { *; }
+-dontwarn fi.iki.elonen.**
+
+# Our own handler subclass, reached through Koin's inlined DSL.
+-keep class com.atharok.btremote.presentation.http.** { *; }
